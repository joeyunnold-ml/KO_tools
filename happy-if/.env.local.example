# Copy this file to .env.local and fill in the values from your Supabase project
# (Settings → API in the Supabase dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# OpenRouter (optional — used for auto-clustering of responses with an LLM).
# Get a key at https://openrouter.ai/keys. If unset, the cluster phase just
# starts empty and the facilitator does it manually.
OPENROUTER_API_KEY=
# Default: anthropic/claude-opus-4.6 — change if you want a different model.
# Browse models at https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-opus-4.6
