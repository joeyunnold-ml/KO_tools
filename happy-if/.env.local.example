# Copy this file to .env.local and fill in the values from your Supabase project
# (Settings → API in the Supabase dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---------------------------------------------------------------------------
# LLM credentials — set ONE of the following. ANTHROPIC takes priority if both
# are set. If neither is set, the cluster phase opens empty and the facilitator
# clusters cards manually (this is a supported fallback, not a failure mode).
# ---------------------------------------------------------------------------

# Option A — Anthropic direct (recommended)
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-4-7
# Other options: claude-sonnet-4-6 (cheaper, ~5x), claude-haiku-4-6 (cheapest)
ANTHROPIC_MODEL=claude-opus-4-7

# Option B — OpenRouter (legacy)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default: anthropic/claude-opus-4.6. Browse models at https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-opus-4.6
